rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.firebaseUid == userId
        && request.resource.data.accountStatus == 'active';
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('firebaseUid' in resource.data) || request.resource.data.firebaseUid == resource.data.firebaseUid)
        && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
        && (!('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus);

      match /products/{productId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;

        match /{collection}/{recordId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
