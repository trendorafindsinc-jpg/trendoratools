VITE_APP_NAME=Trendora Tools

# LUCIA ID / Firebase client configuration
# These values must point to the same Firebase project used by the LUCIA website.
# Set them in your host (Netlify / Vercel / etc.) — never commit real keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional cinematic welcome video URL.
# If empty, the app uses the built-in Pexels default so the video appears as soon as the site loads.
# Default: https://www.pexels.com/download/video/6773475/
VITE_TRENDORA_WELCOME_VIDEO_URL=

# Firebase Console checklist for Google sign-in:
# 1) Authentication → Sign-in method → enable Google
# 2) Authentication → Settings → Authorized domains → add your live domain (and localhost for dev)
# 3) Use the same Web app config as the LUCIA site for VITE_FIREBASE_* above
#
# Never put Firebase Admin credentials or private service-account keys in VITE_ variables.
