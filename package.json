{
  "name": "ariovelle",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/install-icons.mjs",
    "postinstall": "node scripts/install-icons.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:build": "bash scripts/termux-android-build.sh",
    "android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug --no-daemon",
    "db:migrate:plan": "node db/migrate.mjs --plan",
    "db:migrate:apply": "node db/migrate.mjs --apply",
    "db:migrate:verify": "node db/migrate.mjs --verify"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "date-fns": "^3.3.1",
    "firebase": "^12.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "zustand": "^4.5.1",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^1.3.1",
    "@types/pg": "^8.23.1"
  }
}
